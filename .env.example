# Copy to .env (gitignored) and paste at least one provider key.
# Committed files list env var names only — never values, never SSM paths.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Not required to run the demo.
CURSOR_API_KEY=
MUSE_API_KEY=

# Optional staff SSM (local .env only). Leave blank if you only have a pasted key.
# Missing AWS never blocks a stranger with GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY.
EDU_AWS_PROFILE=
EDU_ENVIRONMENT=
EDU_SSM_PREFIX=
